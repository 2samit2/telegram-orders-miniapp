# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:TEST_TOKEN_REPLACE_ME

# Telegram user ID of the manager who receives order notifications.
# You can get it from @userinfobot.
ADMIN_ID=123456789

# Public HTTPS URL of the Web App (Mini App).
# Required for the web_app button inside Telegram; leave empty for local
# development — the bot then shows a regular URL button instead.
WEBAPP_URL=

# FastAPI host / port
HOST=0.0.0.0
PORT=8000

# SQLite file location
DATABASE_PATH=artisan_coffee.sqlite3

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO